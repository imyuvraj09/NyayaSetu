# NyayaSetu RAG Service — Environment Variables
# Copy this file to .env and edit as needed.

# ── Application ──────────────────────────────────────
APP_NAME=NyayaSetu RAG Service
APP_VERSION=1.0.0
ENVIRONMENT=development

# ── Server ───────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Chunking (Phase 4) ───────────────────────────────
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# ── Embeddings & Vector Store (Phase 5) ──────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
VECTOR_DB_PATH=vector_store/chroma_db
VECTOR_COLLECTION_NAME=nyayasetu_legal_documents

# ── Advanced Retrieval & Reranking (Phase 6) ─────────
INITIAL_RETRIEVAL_K=20
FINAL_RETRIEVAL_K=5
MAX_CHUNKS_PER_DOCUMENT=5
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_BATCH_SIZE=16

# ── LLM & Answer Generation (Google Gemini Primary) ─────────
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60
MAX_CONTEXT_CHARS=20000
